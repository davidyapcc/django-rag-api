# Copy to .env for local development.
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-50-characters
DATABASE_URL=postgres://app:app@localhost:5432/ragapi
ALLOWED_HOSTS=localhost,127.0.0.1

# "fake" works offline with no key. Set to "openai" for real answers.
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# USD per 1M tokens, used for cost logging. Check the provider's pricing page.
CHAT_INPUT_PRICE_PER_MTOK=0.10
CHAT_OUTPUT_PRICE_PER_MTOK=0.50
EMBEDDING_PRICE_PER_MTOK=0.02
RAG_MAX_DISTANCE=0.75
# Hybrid retrieval's full-text gate: share of the question's terms a chunk must contain.
RAG_MIN_TEXT_COVERAGE=0.6

# Global LLM spend cap per UTC day; 0 disables. Not enforced for the fake provider.
DEMO_DAILY_BUDGET_USD=0.50
# Each Owner's share of that per UTC day (the Allowance); 0 disables. Guests get the smaller one.
ALLOWANCE_DAILY_USD=0.10
GUEST_ALLOWANCE_DAILY_USD=0.05
GUEST_MAX_DOCUMENTS=5
GUEST_MAX_UPLOAD_BYTES=512000

# Task backend: "immediate" runs in-process (dev, tests, eval); "qstash" pushes via Upstash QStash.
TASK_BACKEND=immediate
# QSTASH_URL=https://qstash.upstash.io
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# QSTASH_CALLBACK_BASE_URL=http://localhost:8000

# Optional OpenTelemetry tracing; off unless an OTLP/HTTP endpoint is set. Spans carry no content.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example.com
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20<key>
# OTEL_SERVICE_NAME=django-rag-api

# Optional Sentry error tracking; off unless a DSN is set. Events are scrubbed of content.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
